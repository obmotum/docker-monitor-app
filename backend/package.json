  "description": "Backend for real-time Docker stats monitoring with native OIDC login",
  "type": "module",
  "main": "server.js",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js"
  },
  "dependencies": {
