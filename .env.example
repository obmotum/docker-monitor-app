# Copy to .env (chmod 600) and fill in. Never commit .env.
# Values containing $ or # must be wrapped in single quotes, e.g. KEY='pa$$#word'

# Client secret of the Keycloak client "valheim-monitor" (Credentials tab)
OIDC_CLIENT_SECRET=

# Random string, at least 32 characters, e.g.: openssl rand -hex 32
SESSION_SECRET=

# Optional
# SESSION_MAX_AGE_HOURS=8
# LOG_TAIL_COUNT=100
